# Generate separate high-entropy values for both secrets.
CONFERIA_SETUP_TOKEN=replace-with-a-random-setup-token
CONFERIA_JWT_SECRET=replace-with-a-base64-encoded-256-bit-secret

CONFERIA_DB_PATH=./instance/conferia
CONFERIA_DB_USERNAME=sa
CONFERIA_DB_PASSWORD=
CONFERIA_UPLOAD_DIR=./instance/uploads

CONFERIA_CORS_ALLOWED_ORIGINS=http://localhost:5173
CONFERIA_BASE_URL=http://localhost:8080
CONFERIA_FRONTEND_URL=http://localhost:5173

CONFERIA_MAIL_HOST=localhost
CONFERIA_MAIL_PORT=1025
CONFERIA_MAIL_FROM=
CONFERIA_MAIL_USERNAME=
CONFERIA_MAIL_PASSWORD=
CONFERIA_MAIL_AUTH=false
CONFERIA_MAIL_STARTTLS=false
